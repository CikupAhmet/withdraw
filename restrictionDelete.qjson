let pjson = {
	"pJson": [
		{
			"T": "Messaging",
			"P": {
				"ID": {
					"H": "PageComp",
					"T": "prop"
				},
				"triggerOnRestored": {
					"H": "false",
					"T": "prop"
				},
				"DiscardSettings": {
					"H": "true",
					"T": "prop",
					"HL": "QS"
				}
			},
			"E": {
				"createRestrictionRequestSuccess": {
					"H": "let restrictionData = response?.createRestrictionReponse?.result;\r\n\r\nif (restrictionData) {\r\n    components.txt_tcknVkn.qValue = restrictionData?.detail?.tcknVkn ?? '-';\r\n    components.txt_customerNumber.qValue = restrictionData?.customerNumber ?? '-';\r\n    components.txt_nameSurname.qValue = restrictionData?.detail?.nameSurname ?? '-';\r\n    components.txt_desc.qValue = restrictionData?.profile?.desc ?? '-';\r\n    components.txt_status.qValue = restrictionData?.detail?.removeInfo?.processDateTime ? statusController(restrictionData?.detail?.removeInfo?.processDateTime) : 'Aktif';\r\n\r\n    components.txt_applyInfo_description.qValue = restrictionData?.detail?.applyInfo?.description ?? '-';\r\n\r\n    components.txt_removeInfo_branch.qValue = (restrictionData?.detail?.removeInfo?.userInfo?.branchCode && restrictionData?.detail?.removeInfo?.userInfo?.branchName) ? (restrictionData?.detail?.removeInfo?.userInfo?.branchCode + ' - ' + restrictionData?.detail?.removeInfo?.userInfo?.branchName) : '-';\r\n    components.txt_removeInfo_employeeId.qValue = restrictionData?.detail?.removeInfo?.userInfo?.employeeId ?? '-';\r\n    components.txt_removeInfo_processDate.qValue = restrictionData?.detail?.removeInfo?.processDateTime ? (new Date(restrictionData?.detail?.removeInfo?.processDateTime).toLocaleDateString('TR-tr')) : '-';\r\n    components.txt_removeInfo_processTime.qValue = restrictionData?.detail?.removeInfo?.processDateTime ? (new Date(restrictionData?.detail?.removeInfo?.processDateTime).toLocaleTimeString('TR-tr')) : '-';\r\n    components.txt_removeInfo_workstationNo.qValue = restrictionData?.detail?.removeInfo?.userInfo?.workstationNo ?? '-';\r\n    components.txt_removeInfo_seqNo.qValue = restrictionData?.detail?.removeInfo?.userInfo?.seqNo ?? '-';\r\n    components.txt_removeInfo_description.qValue = restrictionData?.detail?.removeInfo?.description ?? '-';\r\n\r\n\r\n    let params = {\r\n        'alertType': 'success',\r\n        'message': ['Kısıt koyma işlemi başarıyla sonuçlanmıştır.']\r\n    };\r\n    (<any>components.alertCustomComp).open({ 'params': params });\r\n}\r\nelse {\r\n    let params = {\r\n        'alertType': 'error',\r\n        'message': ['Beklenmeyen bir hata gerçekleşti.', 'Lütfen daha sonra tekrar deneyiniz.']\r\n    };\r\n    (<any>components.alertCustomComp).open({ 'params': params });\r\n}\r\n\r\ncomponents.loadingCustomComp.close();\r\n\r\ncomponents.cont_inputs.visible = false;\r\ncomponents.cont_details.visible = true;\r\n\r\n\r\n\r\n\r\nfunction statusController(dateISOString) {\r\n    let recordDate = new Date(dateISOString).getTime();\r\n    let currentDate = new Date().getTime();\r\n    if (recordDate >= currentDate) {\r\n        return 'Aktif';\r\n    }\r\n    else {\r\n        return 'Pasif';\r\n    }\r\n}",
					"C": true,
					"HL": "TS"
				},
				"btnApplyDisabled": {
					"H": "let desc = components?.txt_input_desc?.qValue?.trim() ?? '';\r\nlet isLegalConfirmationChecked = (components.chk_legalConfirmation.qValue == true);\r\n\r\nif (isLegalConfirmationChecked && desc != '') {\r\n    components.btn_apply.disabled = false;\r\n    components.tooltip_btn_apply.disabled = true;\r\n}\r\nelse {\r\n    components.btn_apply.disabled = true;\r\n    components.tooltip_btn_apply.disabled = false;\r\n    let toolTipContent = '';\r\n    if (!isLegalConfirmationChecked && desc == '') {\r\n        toolTipContent = \"- Kısıt kaldırma nedeni için açıklama girmeniz gerekmektedir. - Kısıt kaldırma nedeni işaretlenmelidir.\";\r\n    }\r\n    else if (!isLegalConfirmationChecked) {\r\n        toolTipContent = \"- Kısıt kaldırma nedeni işaretlenmelidir.\";\r\n    }\r\n    else {\r\n        toolTipContent = \"- Kısıt kaldırma nedeni için açıklama girmeniz gerekmektedir.\";\r\n    }\r\n    components.tooltip_btn_apply.toolTipContent = toolTipContent;\r\n}",
					"C": true,
					"HL": "TS"
				},
				"getRestriction": {
					"H": "declare let restrictionId;\r\n\r\ncomponents.loadingCustomComp.open();\r\n\r\n// let requestObject: any = {};\r\n\r\nlet serviceRequest: any = {};\r\n\r\nserviceRequest.blockRender = '';\r\nserviceRequest.data = null;\r\nserviceRequest.url = '/api/blockage-restriction/restrictions/' + restrictionId;\r\nserviceRequest.http = 'GET';\r\nserviceRequest.responseField = {};\r\nlet responseField: any = 'getRestrictionReponse';\r\nserviceRequest.responseField = responseField;\r\nserviceRequest.onSuccess = 'getRestrictionRequestSuccess';\r\nserviceRequest.onFail = 'getRestrictionRequestFail';\r\nquick.store.set('$customConsumerCode', quick.store.get('customConsumerCode'));\r\nquick.Request.async(serviceRequest);",
					"C": true,
					"HL": "TS"
				},
				"getRestrictionRequestSuccess": {
					"H": "let restrictionData = response?.getRestrictionReponse?.result;\r\n\r\nif (restrictionData) {\r\n    components.txt_tcknVkn.qValue = restrictionData?.detail?.tcknVkn ?? '-';\r\n    components.txt_customerNumber.qValue = restrictionData?.customerNumber ?? '-';\r\n    components.txt_nameSurname.qValue = restrictionData?.detail?.nameSurname ?? '-';\r\n    components.txt_desc.qValue = restrictionData?.profile?.desc ?? '-';\r\n    components.txt_processDate.qValue = restrictionData?.detail?.applyInfo?.processDateTime ? (new Date(restrictionData?.detail?.applyInfo?.processDateTime).toLocaleDateString('TR-tr')) : '-';\r\n    components.txt_status.qValue = restrictionData?.detail?.removeInfo?.processDateTime ? statusController(restrictionData?.detail?.removeInfo?.processDateTime) : 'Aktif';\r\n\r\n    components.txt_applyInfo_description.qValue = restrictionData?.detail?.applyInfo?.description ?? '-';\r\n\r\n    components.txt_removeInfo_branch.qValue = (restrictionData?.detail?.removeInfo?.userInfo?.branchCode && restrictionData?.detail?.removeInfo?.userInfo?.branchName) ? (restrictionData?.detail?.removeInfo?.userInfo?.branchCode + ' - ' + restrictionData?.detail?.removeInfo?.userInfo?.branchName) : '-';\r\n    components.txt_removeInfo_employeeId.qValue = restrictionData?.detail?.removeInfo?.userInfo?.employeeId ?? '-';\r\n    components.txt_removeInfo_processDate.qValue = restrictionData?.detail?.removeInfo?.processDateTime ? (new Date(restrictionData?.detail?.removeInfo?.processDateTime).toLocaleDateString('TR-tr')) : '-';\r\n    components.txt_removeInfo_processTime.qValue = restrictionData?.detail?.removeInfo?.processDateTime ? (new Date(restrictionData?.detail?.removeInfo?.processDateTime).toLocaleTimeString('TR-tr')) : '-';\r\n    components.txt_removeInfo_workstationNo.qValue = restrictionData?.detail?.removeInfo?.userInfo?.workstationNo ?? '-';\r\n    components.txt_removeInfo_seqNo.qValue = restrictionData?.detail?.removeInfo?.userInfo?.seqNo ?? '-';\r\n    components.txt_removeInfo_description.qValue = restrictionData?.detail?.removeInfo?.description ?? '-';\r\n\r\n    quick.store.set('restrictionData', restrictionData);\r\n}\r\nelse {\r\n    let params = {\r\n        'alertType': 'error',\r\n        'message': ['Beklenmeyen bir hata gerçekleşti.', 'Lütfen daha sonra tekrar deneyiniz.']\r\n    };\r\n    (<any>components.alertCustomComp).open({ 'params': params });\r\n}\r\n\r\n\r\ncomponents.loadingCustomComp.close();\r\n\r\n\r\nfunction statusController(dateISOString) {\r\n    let recordDate = new Date(dateISOString).getTime();\r\n    let currentDate = new Date().getTime();\r\n    if (recordDate >= currentDate) {\r\n        return 'Aktif';\r\n    }\r\n    else {\r\n        return 'Pasif';\r\n    }\r\n}",
					"C": true,
					"HL": "TS"
				},
				"getRestrictionRequestFail": {
					"H": "declare let error;\r\n\r\ncomponents.loadingCustomComp.close();\r\n\r\nif (error?.response?.status == 404) {\r\n    let restrictionId = quick.store.get('$selectedRestrictionId');\r\n    let params = {\r\n        'alertType': 'error',\r\n        'message': [restrictionId + \" id'li kısıt kaydı bulunamadı.\"]\r\n    };\r\n    (<any>components.alertCustomComp).open({ 'params': params });\r\n}\r\nelse {\r\n    let params = {\r\n        'alertType': 'error',\r\n        'message': ['Beklenmeyen bir hata gerçekleşti.', 'Lütfen daha sonra tekrar deneyiniz.']\r\n    };\r\n\r\n    if (error.response.data.code && error.response.data.error && error.response.data.message) {\r\n        params = {\r\n            'alertType': 'error',\r\n            'message': [error.response.data.code, error.response.data.error + ' - ' + error.response.data.message]\r\n        }\r\n    }\r\n    (<any>components.alertCustomComp).open({ 'params': params });\r\n}",
					"C": true,
					"HL": "TS"
				},
				"deleteRestriction": {
					"H": "components.loadingCustomComp.open();\r\n\r\nlet restrictionData = quick.store.get('restrictionData');\r\n\r\ncomponents.loadingCustomComp.open();\r\n\r\nlet requestObject: any = {\r\n  \"restrictionId\": restrictionData?.id,\r\n  \"description\": components.txt_input_desc?.qValue?.trim(),\r\n  \"removeRuleInfo\": {\r\n    \"ruleTypeDicId\": 307,\r\n    // \"ruleStDicId\": 311,\r\n    \"ruleStDicId\": 310,\r\n    \"ruleHstTrxTypeDicId\": 314\r\n  }\r\n};\r\n\r\nquick.store.set('deleteRestrictionDescription', requestObject.description);\r\n\r\nlet serviceRequest: any = {};\r\n\r\nserviceRequest.blockRender = '';\r\nserviceRequest.data = requestObject;\r\nserviceRequest.url = '/api/blockage-restriction/restrictions';\r\nserviceRequest.http = 'DELETE';\r\nserviceRequest.responseField = {};\r\nlet responseField: any = 'deleteRestrictionReponse';\r\nserviceRequest.responseField = responseField;\r\nserviceRequest.onSuccess = 'deleteRestrictionRequestSuccess';\r\nserviceRequest.onFail = 'deleteRestrictionRequestFail';\r\nquick.store.set('$customConsumerCode', quick.store.get('customConsumerCode'));\r\nquick.Request.async(serviceRequest);",
					"C": true,
					"HL": "TS"
				},
				"deleteRestrictionRequestSuccess": {
					"H": "let customerData: any = quick.containerServices.getCustomerContext() ?? {};\r\nlet customerNameSurname = customerData?.firstName;\r\ncustomerData?.secondName?.trim() != '' ? customerNameSurname += ' ' + customerData?.secondName : customerNameSurname += ' ';\r\ncustomerNameSurname += customerData?.customerSurname?.trim();\r\n\r\nlet restrictionData = response?.deleteRestrictionReponse?.success;\r\n\r\nif (restrictionData) {\r\n    \r\n    let restrictionId = quick.store.get('$selectedRestrictionId');\r\n    quick.MM.trigger('getRestriction', [{ 'restrictionId': restrictionId }]);\r\n\r\n    let params = {\r\n        'alertType': 'success',\r\n        'message': ['Kısıt kaldırma işlemi başarıyla sonuçlanmıştır.']\r\n    };\r\n    (<any>components.alertCustomComp).open({ 'params': params });\r\n    components.dia_restrictionDetails.qValue = false;\r\n\r\n    quick.MM.trigger('createAbm',[{'pcuBytesValue':'A'}]);\r\n}\r\nelse {\r\n    let params = {\r\n        'alertType': 'error',\r\n        'message': ['Beklenmeyen bir hata gerçekleşti.', 'Lütfen daha sonra tekrar deneyiniz.']\r\n    };\r\n    (<any>components.alertCustomComp).open({ 'params': params });\r\n\r\n    quick.MM.trigger('createAbm',[{'pcuBytesValue':'A'}]);\r\n}\r\n\r\ncomponents.loadingCustomComp.close();\r\n\r\ncomponents.cont_inputs.visible = false;\r\ncomponents.row_legalConfirmation.visible = false;\r\ncomponents.row_restrictionRemoveDetails.visible = true;\r\n\r\n\r\n\r\n\r\nfunction statusController(dateISOString) {\r\n    let recordDate = new Date(dateISOString).getTime();\r\n    let currentDate = new Date().getTime();\r\n    if (recordDate >= currentDate) {\r\n        return 'Aktif';\r\n    }\r\n    else {\r\n        return 'Pasif';\r\n    }\r\n}",
					"C": true,
					"HL": "TS"
				},
				"deleteRestrictionRequestFail": {
					"H": "declare let error;\r\n\r\nquick.MM.trigger('createAbm',[{'pcuBytesValue':'A'}]);\r\n\r\ncomponents.loadingCustomComp.close();\r\n\r\nlet params = {\r\n    'alertType': 'error',\r\n    'message': ['Beklenmeyen bir hata gerçekleşti.', 'Lütfen daha sonra tekrar deneyiniz.']\r\n};\r\n\r\nif (error.response.data.code && error.response.data.error && error.response.data.message) {\r\n    params = {\r\n        'alertType': 'error',\r\n        'message': [error.response.data.code, error.response.data.error + ' - ' + error.response.data.message]\r\n    }\r\n}\r\n(<any>components.alertCustomComp).open({ 'params': params });",
					"C": true,
					"HL": "TS"
				},
				"EndRender": {
					"H": "quick.store.set('customConsumerCode', 'TANE.BLKRESTRICTION');",
					"HL": "TS"
				},
				"createAbm": {
					"H": "declare let pcuBytesValue;\r\n\r\nlet customerData: any = quick.containerServices.getCustomerContext() ?? {};\r\n\r\nlet userData: any = quick.containerServices.getUserContext() ?? {};\r\n\r\nlet deleteRestrictionDescription = quick.store.get('deleteRestrictionDescription');\r\n\r\nlet restrictionData = response?.deleteRestrictionReponse?.result;\r\n\r\nlet tod = undefined;\r\nlet seqNo = undefined;\r\n\r\nif (restrictionData) {\r\n    tod = restrictionData.tod;\r\n    seqNo = restrictionData.sequenceNo;\r\n}\r\n\r\nlet requestObject: any = {\r\n    \"tod\": tod,\r\n    \"customerNumber\": customerData?.customerNumber ?? \"\",\r\n    \"tellerId\": +userData?.workstationBO?.code,\r\n    \"sequenceNo\": seqNo,\r\n    \"employeeId\": +userData?.userid,\r\n    \"processingOrganizationUnit\": +userData?.workstationBO?.organizationUnitCode,\r\n    \"channelCode\": \"branch\",\r\n    \"transactionCode\": \"KISITISL\",\r\n    \"operationCode\": \"KISITKAL\",\r\n    \"operationAddress\": userData?.ip,\r\n    \"part\": \"0\",\r\n    \"productCode\": 0,\r\n    \"monetaryType\": \"Z\",\r\n    \"accountType\": \"M\",\r\n    \"groupType\": \"Z001\",\r\n    \"type\": \"A\",\r\n    \"pcuBytes\": pcuBytesValue,\r\n    \"isCancellation\": false,\r\n    \"abmDetails\": {\r\n        \"operationDescription\": deleteRestrictionDescription,\r\n    }\r\n};\r\n\r\n\r\nif (customerData.customerType == 'CORPORATE') {\r\n    requestObject.taxId = +customerData.customerTaxId;\r\n}\r\nelse {\r\n    requestObject.citizenId = +customerData.customerCitizenId;\r\n}\r\n\r\n\r\nlet serviceRequest: any = {};\r\n\r\nserviceRequest.blockRender = '';\r\nserviceRequest.data = requestObject;\r\nserviceRequest.url = '/api/blockage-restriction/create-abm';\r\nserviceRequest.http = 'POST';\r\nserviceRequest.responseField = {};\r\nlet responseField: any = 'createAbmReponse';\r\nserviceRequest.responseField = responseField;\r\nserviceRequest.onSuccess = 'createAbmRequestSuccess';   // kullanılmıyor/bakılmıyor, o yüzden oluşturulmadı\r\nserviceRequest.onFail = 'createAbmRequestFail';         // kullanılmıyor/bakılmıyor, o yüzden oluşturulmadı\r\nquick.store.set('$customConsumerCode', quick.store.get('customConsumerCode'));\r\nquick.Request.async(serviceRequest);",
					"C": true,
					"HL": "TS"
				}
			},
