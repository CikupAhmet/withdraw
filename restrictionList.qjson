let pjson = {
	"pJson": [
		{
			"T": "Messaging",
			"P": {
				"ID": {
					"H": "PageComp",
					"T": "prop"
				},
				"triggerOnRestored": {
					"H": "false",
					"T": "prop"
				},
				"DiscardSettings": {
					"H": "true",
					"T": "prop",
					"HL": "QS"
				}
			},
			"E": {
				"formatDataForTable": {
					"H": "declare let blockageCodeList;\r\n\r\nlet modifiedBlockageCodeList = blockageCodeList.map((blockageCode) => {\r\n    let tmpBlockageCodeObj = {\r\n        'code': blockageCode.code.trim(),\r\n        'description': blockageCode.description,\r\n        'mainTypeDictionary': blockageCode.mainTypeDictionary.description,\r\n        'applyAuthorizationDictionary': blockageCode.applyAuthorizationDictionary.description,\r\n        'removeAuthorizationDictionary': blockageCode.removeAuthorizationDictionary.description,\r\n        'active': blockageCode.active,\r\n        // 'dateRequired': blockageCode.dateRequired,\r\n        'chk_blockageTimeTillExpiry': blockageCode.blockageTimeTillExpiry != 0 ? true : false,\r\n        'blockageTimeTillExpiry': blockageCode.blockageTimeTillExpiry != 0 ? blockageCode.blockageTimeTillExpiry + ' gün' : '-',\r\n        'data': blockageCode\r\n    }\r\n    return tmpBlockageCodeObj;\r\n});\r\n\r\n(<any>components.paginationCustomComp_restrictionList).setItems({ 'items': modifiedBlockageCodeList });\r\ncomponents.tbl_restrictionList.items = modifiedBlockageCodeList;\r\n\r\ncomponents.loadingCustomComp.close();\r\n\r\nquick.MM.trigger('updateTableFooter');",
					"C": true,
					"HL": "TS"
				},
				"getRestrictions": {
					"H": "components.loadingCustomComp.open();\r\n\r\nlet customerData: any = quick.containerServices.getCustomerContext() ?? {};\r\n// let customerData = { customerNumber: '161109109' };\r\n// let customerData = { customerNumber: '161195504' };\r\n// let customerData = { customerNumber: '162006612' };\r\n\r\nlet requestObject: any = {};\r\n\r\nif (customerData?.customerNumber != undefined && customerData?.customerNumber != '') {\r\n    requestObject.customerNo = customerData?.customerNumber;\r\n\r\n    let serviceRequest: any = {};\r\n\r\n    serviceRequest.blockRender = '';\r\n    serviceRequest.data = requestObject;\r\n    serviceRequest.url = '/api/blockage-restriction/restrictions';\r\n    serviceRequest.http = 'GET';\r\n    serviceRequest.responseField = {};\r\n    let responseField: any = 'getRestrictionsReponse';\r\n    serviceRequest.responseField = responseField;\r\n    serviceRequest.onSuccess = 'getRestrictionsRequestSuccess';\r\n    serviceRequest.onFail = 'getRestrictionsRequestFail';\r\n    quick.store.set('$customConsumerCode', quick.store.get('customConsumerCode'));\r\n    quick.Request.async(serviceRequest);\r\n}\r\nelse {\r\n    let params = {\r\n        'alertType': 'error',\r\n        'message': ['Müşteri bulunamadı.']\r\n    };\r\n    (<any>components.alertCustomComp).open({ 'params': params });\r\n}",
					"C": true,
					"HL": "TS"
				},
				"getRestrictionsRequestSuccess": {
					"H": "let restrictionList = response?.getRestrictionsReponse?.result ?? [];\r\n\r\nif (restrictionList.length > 0) {\r\n    restrictionList.sort((a, b) => (a.id > b.id ? -1 : 1));\r\n    let tmpTableList = restrictionList.map((item) => {\r\n        let tmpItem = {\r\n            'id': item?.id,\r\n            'tcknVkn': item?.detail?.tcknVkn ?? '-',\r\n            'customerNameSurname': item?.detail?.nameSurname ?? '-',\r\n            'customerNo': item?.customerNumber ?? '-',\r\n            'applyTime': item?.detail?.applyInfo?.processDateTime ? (new Date(item?.detail?.applyInfo?.processDateTime).toLocaleDateString('TR-tr')) : '-',\r\n            'restrictionDescription': item?.profile?.desc ?? '-',\r\n            'removeTime': item?.detail?.removeInfo?.processDateTime ? (new Date(item?.detail?.removeInfo?.processDateTime).toLocaleDateString('TR-tr')) : '-',\r\n            'status': item?.detail?.removeInfo?.processDateTime ? statusController(item?.detail?.removeInfo?.processDateTime) : 'Aktif',\r\n            'data': item,\r\n        }\r\n        return tmpItem;\r\n    });\r\n\r\n    (<any>components.paginationCustomComp_restrictionList).setItems({ 'items': tmpTableList });\r\n    components.paginationCustomComp_restrictionList.updateTableFooter();\r\n}\r\nelse {\r\n    let customerData: any = quick.containerServices.getCustomerContext() ?? {};\r\n    let customerNumber = customerData?.customerNumber;\r\n    let customerNameSurname = customerData?.customerName + ' ' + customerData?.customerSurname;\r\n    let params = {\r\n        'alertType': 'error',\r\n        'message': ['Giriş yapılan ' + customerNumber + ' - ' + customerNameSurname + ' müşterisine ait bir kısıt bulunmamaktadır.']\r\n    };\r\n    (<any>components.alertCustomComp).open({ 'params': params });\r\n}\r\n\r\ncomponents.loadingCustomComp.close();\r\n\r\nfunction statusController(dateISOString) {\r\n    let recordDate = new Date(dateISOString).getTime();\r\n    let currentDate = new Date().getTime();\r\n    if (recordDate >= currentDate) {\r\n        return 'Aktif';\r\n    }\r\n    else {\r\n        return 'Pasif';\r\n    }\r\n}",
					"C": true,
					"HL": "TS"
				},
				"getRestrictionsRequestFail": {
					"H": "declare let error;\r\n\r\ncomponents.loadingCustomComp.close();\r\n\r\nlet params = {\r\n    'alertType': 'error',\r\n    'message': ['Beklenmeyen bir hata gerçekleşti.', 'Lütfen daha sonra tekrar deneyiniz.']\r\n};\r\n\r\nif (error.response.data.code && error.response.data.error && error.response.data.message) {\r\n    params = {\r\n        'alertType': 'error',\r\n        'message': [error.response.data.code, error.response.data.error + ' - ' + error.response.data.message]\r\n    }\r\n}\r\n(<any>components.alertCustomComp).open({ 'params': params });",
					"C": true,
					"HL": "TS"
				},
				"clearPage": {
					"H": "(<any>components.tbl_restrictionList).select();\r\n(<any>components.paginationCustomComp_restrictionList).setItems({ 'items': [] });\r\ncomponents.btn_deleteRestriction.disabled = true;\r\ncomponents.btn_details.disabled = true;",
					"C": true,
					"HL": "TS"
				},
				"EndRender": {
					"H": "quick.store.set('customConsumerCode', 'TANE.BLKRESTRICTION');",
					"HL": "TS"
				}
			},
			"C": {},
			"_Editor": {
				"eID": "EdtrComp_1"
			},
