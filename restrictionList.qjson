																				"footerProps": {
																					"H": "{showFirstLastPage = true,\nfirstIcon = 'mdi-arrow-collapse-left',\nlastIcon = 'mdi-arrow-collapse-right',\nprevIcon = 'mdi-minus',\nnextIcon = 'mdi-plus'}",
																					"T": "prop"
																				},
																				"headers": {
																					"H": "[{ text = 'TCKN / VKN / YKN', align= 'start', sortable= true, value= 'tcknVkn', filterable= true },\n{ text = 'Ad Soyad / Unvan', sortable= true, value= 'customerNameSurname', filterable= true },\n{ text = 'Müşteri Numarası', sortable= true, value= 'customerNo', filterable= true },\n{ text = 'Kısıt Koyma Tarihi', sortable= true, value= 'applyTime', filterable= true },\n{ text = 'Kısıt Nedeni', sortable= true, value= 'restrictionDescription', filterable= true },\n{ text = 'Kısıt Kaldırma Tarihi', sortable= true, value= 'removeTime', filterable= true },\n{ text = 'Kısıt Durumu', sortable= true, value= 'status', filterable= true }]",
																					"T": "prop",
