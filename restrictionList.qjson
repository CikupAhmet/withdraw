																					"H": "'id'",
																					"T": "prop",
																					"HL": "QS"
																				}
																			},
																			"E": {
																				"click:row": {
																					"H": "let lastSelection = (<any>components.tbl_restrictionList).selection[(<any>Object).keys((<any>components.tbl_restrictionList).selection)];\r\n\r\nif (lastSelection) {\r\n    if (lastSelection.id == row.item.id) {\r\n        quick.this.select();\r\n    }\r\n    else {\r\n        quick.this.select(row.item);\r\n    }\r\n}\r\nelse {\r\n    quick.this.select(row.item);\r\n}",
																					"P": "index:any,row:IVDataTableClickRow",
																					"HL": "TS"
																				},
																				"item-selected": {
																					"H": "if (rowObj?.item && rowObj?.value) {\r\n    components.btn_details.disabled = false;\r\n}\r\nelse {\r\n    components.btn_details.disabled = true;\r\n}\r\n\r\ncomponents.btn_deleteRestriction.disabled = rowObj?.item?.status != 'Aktif' ? true : false;\r\ncomponents.btn_createRestriction.disabled = rowObj?.item?.status != 'Aktif' ? false : true;",
																					"P": "rowObj:IVDataTableItemSelect",
																					"HL": "TS"
																				}
																			},
