let pjson = {
	"pJson": [
		{
			"T": "Messaging",
			"P": {
				"ID": {
					"H": "PageComp",
					"T": "prop"
				},
				"triggerOnRestored": {
					"H": "false",
					"T": "prop"
				},
				"DiscardSettings": {
					"H": "true",
					"T": "prop",
					"HL": "QS"
				}
			},
			"E": {
				"getRestriction": {
					"H": "declare let restrictionId;\r\n\r\ncomponents.loadingCustomComp.open();\r\n\r\n// let requestObject: any = {};\r\n\r\nlet serviceRequest: any = {};\r\n\r\nserviceRequest.blockRender = '';\r\nserviceRequest.data = null;\r\nserviceRequest.url = '/api/blockage-restriction/restrictions/' + restrictionId;\r\nserviceRequest.http = 'GET';\r\nserviceRequest.responseField = {};\r\nlet responseField: any = 'getRestrictionReponse';\r\nserviceRequest.responseField = responseField;\r\nserviceRequest.onSuccess = 'getRestrictionRequestSuccess';\r\nserviceRequest.onFail = 'getRestrictionRequestFail';\r\nquick.store.set('$customConsumerCode', quick.store.get('customConsumerCode'));\r\nquick.Request.async(serviceRequest);",
					"C": true,
					"HL": "TS"
				},
				"getRestrictionRequestSuccess": {
					"H": "let restrictionData = response?.getRestrictionReponse?.result;\r\nquick.EM.trace(restrictionData)\r\n\r\nif (restrictionData) {\r\n    components.txt_tcknVkn.qValue = restrictionData?.detail?.tcknVkn ?? '-';\r\n    components.txt_customerNumber.qValue = restrictionData?.customerNumber ?? '-';\r\n    components.txt_nameSurname.qValue = restrictionData?.detail?.nameSurname ?? '-';\r\n    components.txt_desc.qValue = restrictionData?.profile?.desc ?? '-';\r\n    components.txt_status.qValue = restrictionData?.detail?.removeInfo?.processDateTime ? statusController(restrictionData?.detail?.removeInfo?.processDateTime) : 'Aktif';\r\n\r\n    components.txt_applyInfo_branch.qValue = (restrictionData?.detail?.applyInfo?.userInfo?.branchCode && restrictionData?.detail?.applyInfo?.userInfo?.branchName) ? (restrictionData?.detail?.applyInfo?.userInfo?.branchCode + ' - ' + restrictionData?.detail?.applyInfo?.userInfo?.branchName) : '-';\r\n    components.txt_applyInfo_employeeId.qValue = restrictionData?.detail?.applyInfo?.userInfo?.employeeId ?? '-';\r\n    components.txt_applyInfo_processDate.qValue = restrictionData?.detail?.applyInfo?.processDateTime ? (new Date(restrictionData?.detail?.applyInfo?.processDateTime).toLocaleDateString('TR-tr')) : '-';\r\n    components.txt_applyInfo_processTime.qValue = restrictionData?.detail?.applyInfo?.processDateTime ? (new Date(restrictionData?.detail?.applyInfo?.processDateTime).toLocaleTimeString('TR-tr')) : '-';\r\n    components.txt_applyInfo_workstationNo.qValue = restrictionData?.detail?.applyInfo?.userInfo?.workstationNo ?? '-';\r\n    components.txt_applyInfo_seqNo.qValue = restrictionData?.detail?.applyInfo?.userInfo?.seqNo ?? '-';\r\n    components.txt_applyInfo_description.qValue = restrictionData?.detail?.applyInfo?.description ?? '-';\r\n\r\n    if (restrictionData?.detail?.removeInfo?.processDateTime) {\r\n        components.col_removeInfo.visible = true;\r\n\r\n        components.txt_removeInfo_branch.qValue = (restrictionData?.detail?.removeInfo?.userInfo?.branchCode && restrictionData?.detail?.removeInfo?.userInfo?.branchName) ? (restrictionData?.detail?.removeInfo?.userInfo?.branchCode + ' - ' + restrictionData?.detail?.removeInfo?.userInfo?.branchName) : '-';\r\n        components.txt_removeInfo_employeeId.qValue = restrictionData?.detail?.removeInfo?.userInfo?.employeeId ?? '-';\r\n        components.txt_removeInfo_processDate.qValue = restrictionData?.detail?.removeInfo?.processDateTime ? (new Date(restrictionData?.detail?.removeInfo?.processDateTime).toLocaleDateString('TR-tr')) : '-';\r\n        components.txt_removeInfo_processTime.qValue = restrictionData?.detail?.removeInfo?.processDateTime ? (new Date(restrictionData?.detail?.removeInfo?.processDateTime).toLocaleTimeString('TR-tr')) : '-';\r\n        components.txt_removeInfo_workstationNo.qValue = restrictionData?.detail?.removeInfo?.userInfo?.workstationNo ?? '-';\r\n        components.txt_removeInfo_seqNo.qValue = restrictionData?.detail?.removeInfo?.userInfo?.seqNo ?? '-';\r\n        components.txt_removeInfo_description.qValue = restrictionData?.detail?.removeInfo?.description ?? '-';\r\n    }\r\n    else {\r\n        components.col_removeInfo.visible = false;\r\n    }\r\n}\r\nelse {\r\n    let params = {\r\n        'alertType': 'error',\r\n        'message': ['Beklenmeyen bir hata gerçekleşti.', 'Lütfen daha sonra tekrar deneyiniz.']\r\n    };\r\n    (<any>components.alertCustomComp).open({ 'params': params });\r\n}\r\n\r\n\r\ncomponents.loadingCustomComp.close();\r\n\r\n\r\nfunction statusController(dateISOString) {\r\n    let recordDate = new Date(dateISOString).getTime();\r\n    let currentDate = new Date().getTime();\r\n    quick.EM.trace(\"tarihler\")\r\n    quick.EM.trace(recordDate);\r\n    quick.EM.trace(currentDate);\r\n    if (recordDate >= currentDate) {\r\n        return 'Aktif';\r\n    }\r\n    else {\r\n        return 'Pasif';\r\n    }\r\n}",
					"C": true,
					"HL": "TS"
				},
				"getRestrictionRequestFail": {
					"H": "declare let error;\r\n\r\ncomponents.loadingCustomComp.close();\r\n\r\nif (error?.response?.status == 404) {\r\n    let restrictionId = quick.store.get('$selectedRestrictionId');\r\n    let params = {\r\n        'alertType': 'error',\r\n        'message': [restrictionId + \" id'li kısıt kaydı bulunamadı.\"]\r\n    };\r\n    (<any>components.alertCustomComp).open({ 'params': params });\r\n}\r\nelse {\r\n    let params = {\r\n        'alertType': 'error',\r\n        'message': ['Beklenmeyen bir hata gerçekleşti.', 'Lütfen daha sonra tekrar deneyiniz.']\r\n    };\r\n\r\n    if (error.response.data.code && error.response.data.error && error.response.data.message) {\r\n        params = {\r\n            'alertType': 'error',\r\n            'message': [error.response.data.code, error.response.data.error + ' - ' + error.response.data.message]\r\n        }\r\n    }\r\n    (<any>components.alertCustomComp).open({ 'params': params });\r\n}",
					"C": true,
					"HL": "TS"
				},
				"EndRender": {
					"H": "quick.store.set('customConsumerCode', 'TANE.BLKRESTRICTION');",
					"HL": "TS"
				}
			},
			"C": {},
