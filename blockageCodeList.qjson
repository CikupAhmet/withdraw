let pjson = {
	"pJson": [
		{
			"T": "Messaging",
			"P": {
				"ID": {
					"H": "PageComp",
					"T": "prop"
				},
				"triggerOnRestored": {
					"H": "false",
					"T": "prop"
				},
				"DiscardSettings": {
					"H": "true",
					"T": "prop",
					"HL": "QS"
				}
			},
			"E": {
				"getCodes": {
					"H": "components.loadingCustomComp.open();\r\n\r\n// let requestObject = {\r\n//     'active': isActive\r\n// };\r\n\r\nlet serviceRequest: any = {};\r\n\r\nserviceRequest.blockRender = '';\r\nserviceRequest.data = null;\r\nserviceRequest.url = '/api/blockage-codes/codes';\r\nserviceRequest.http = 'GET';\r\nserviceRequest.responseField = {};\r\nlet responseField: any = 'getCodesReponse';\r\nserviceRequest.responseField = responseField;\r\nserviceRequest.onSuccess = 'getCodesRequestSuccess';\r\nserviceRequest.onFail = 'getCodesRequestFail';\r\nquick.store.set('$customConsumerCode', quick.store.get('customConsumerCode'));\r\nquick.Request.async(serviceRequest);",
					"C": true,
					"HL": "TS"
				},
				"getCodesRequestSuccess": {
					"H": "let codeList = response?.getCodesReponse?.result ?? [];\r\n\r\nquick.MM.trigger('formatDataForTable', [{ 'blockageCodeList': codeList }]);",
					"C": true,
					"HL": "TS"
				},
				"getCodesRequestFail": {
					"H": "declare let error;\r\n\r\ncomponents.loadingCustomComp.close();\r\n\r\nlet params = {\r\n    'alertType': 'error',\r\n    'message': ['Beklenmeyen bir hata gerçekleşti.', 'Lütfen daha sonra tekrar deneyiniz.']\r\n};\r\n\r\nif (error.response.data.code && error.response.data.error && error.response.data.message) {\r\n    params = {\r\n        'alertType': 'error',\r\n        'message': [error.response.data.code, error.response.data.error + ' - ' + error.response.data.message]\r\n    }\r\n}\r\n(<any>components.alertCustomComp).open({ 'params': params });",
					"C": true,
					"HL": "TS"
				},
				"formatDataForTable": {
					"H": "declare let blockageCodeList;\r\n\r\nlet modifiedBlockageCodeList = blockageCodeList.map((blockageCode) => {\r\n    let tmpBlockageCodeObj = {\r\n        'code': blockageCode.code.trim(),\r\n        'description': blockageCode.description,\r\n        'mainTypeDictionary': blockageCode.mainTypeDictionary.description,\r\n        'applyAuthorizationDictionary': blockageCode.applyAuthorizationDictionary.description,\r\n        'removeAuthorizationDictionary': blockageCode.removeAuthorizationDictionary.description,\r\n        'active': blockageCode.active,\r\n        // 'dateRequired': blockageCode.dateRequired,\r\n        'chk_blockageTimeTillExpiry': blockageCode.blockageTimeTillExpiry != 0 ? true : false,\r\n        'blockageTimeTillExpiry': blockageCode.blockageTimeTillExpiry != 0 ? blockageCode.blockageTimeTillExpiry + ' gün' : '-',\r\n        'data': blockageCode\r\n    }\r\n    return tmpBlockageCodeObj;\r\n});\r\n\r\nquick.store.set('allItems', modifiedBlockageCodeList);\r\n\r\ncomponents.tbl_blockageCode.items = modifiedBlockageCodeList;\r\n\r\ncomponents.loadingCustomComp.close();\r\n\r\nquick.MM.trigger('updateTableFooter');",
					"C": true,
					"HL": "TS"
				},
				"updateTableFooter": {
					"H": "let totalItemNumber = components.tbl_blockageCode.items.length;\r\nlet currentPage = components.tbl_blockageCode.page;\r\nlet itemsPerPage = components.tbl_blockageCode.itemsPerPage;\r\nlet totalPageNumber = Math.ceil(totalItemNumber / itemsPerPage);\r\n\r\ncomponents.lbl_totalItems.text = totalItemNumber;\r\ncomponents.lbl_firstItemOrder.text = ((itemsPerPage * (currentPage - 1)) + 1).toString();\r\n\r\nif (currentPage == totalPageNumber) {\r\n    components.lbl_lastItemOrder.text = totalItemNumber;\r\n    components.ico_nextPage.disabled = true;\r\n    components.ico_lastPage.disabled = true;\r\n}\r\nelse {\r\n    components.lbl_lastItemOrder.text = (itemsPerPage * currentPage).toString();\r\n    components.ico_nextPage.disabled = false;\r\n    components.ico_lastPage.disabled = false;\r\n}\r\n\r\nif (currentPage == 1) {\r\n    components.ico_prevPage.disabled = true;\r\n    components.ico_firstPage.disabled = true;\r\n}\r\nelse {\r\n    components.ico_prevPage.disabled = false;\r\n    components.ico_firstPage.disabled = false;\r\n}\r\n\r\ncomponents.lbl_page.text = currentPage.toString();",
					"C": true,
					"HL": "TS"
				},
				"PostRender": {
					"H": "quick.store.set('customConsumerCode', 'TANE.BLKLIST');",
					"TO": 1,
					"HL": "TS"
				}
			},
