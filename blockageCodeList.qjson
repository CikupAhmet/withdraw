																								"click": {
																									"H": "let totalItemNumber = components.tbl_blockageCode.items.length;\r\nlet currentPage = components.tbl_blockageCode.page;\r\nlet itemsPerPage = components.tbl_blockageCode.itemsPerPage;\r\nlet totalPageNumber = Math.ceil(totalItemNumber / itemsPerPage);\r\n\r\nif (currentPage < totalPageNumber) {\r\n    components.tbl_blockageCode.page += 1;\r\n    currentPage += 1;\r\n}\r\n\r\n\r\ncomponents.ico_prevPage.disabled = false;\r\ncomponents.ico_firstPage.disabled = false;\r\n\r\nif (currentPage == totalPageNumber) {\r\n    components.ico_nextPage.disabled = true;\r\n    components.ico_lastPage.disabled = true;\r\n}\r\n\r\nquick.MM.trigger('updateTableFooter');",
