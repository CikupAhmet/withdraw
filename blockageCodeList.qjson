															"E": {
																"input": {
																	"H": "value = value ?? '';\r\n\r\nlet items = quick.store.get('allItems');\r\ncomponents.tbl_blockageCode.items = [];\r\n\r\nlet filterHeaders = [];\r\n\r\ncomponents.tbl_blockageCode.headers.forEach((header) => {\r\n    if (header?.filterable) {\r\n        filterHeaders.push(header.value);\r\n    }\r\n});\r\n\r\nlet filteredItems: any = [];\r\n\r\nitems.forEach((item) => {\r\n    filterHeaders.forEach((header) => {\r\n        if (item[header].toLocaleLowerCase('TR-tr').includes(value.toLocaleLowerCase('TR-tr')) || item[header].toLocaleUpperCase('TR-tr').includes(value.toLocaleUpperCase('TR-tr'))) {\r\n            if (!filteredItems.includes(item)) {\r\n                filteredItems.push(item);\r\n            }\r\n        }\r\n    });\r\n});\r\n\r\nif (value?.length > 0) {\r\n    components.lbl_totalRecordInSearch.text = ' Arası Kayıtlar ( ' + items?.length + ' Kayıt İçerisinden Bulunan )';\r\n}\r\nelse {\r\n    components.lbl_totalRecordInSearch.text = ' Arası Kayıtlar';\r\n}\r\ncomponents.tbl_blockageCode.items = filteredItems;\r\ncomponents.tbl_blockageCode.page = 1;\r\n\r\nquick.MM.trigger('updateTableFooter');",
																	"P": "value:any",
																	"HL": "TS"
																},
																"click:clear": {
																	"H": "// let items = quick.store.get('allItems');\r\n// debugger\r\n// components.tbl_blockageCode.items = items;\r\n// components.tbl_blockageCode.page = 1;\r\n\r\n// quick.MM.trigger('updateTableFooter');",
																	"P": "mouseEvent:unknown | undefined",
																	"HL": "TS"
																}
															},
