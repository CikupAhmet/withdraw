let pjson = {
	"pJson": [
		{
			"T": "Messaging",
			"P": {
				"ID": {
					"H": "PageComp",
					"T": "prop"
				},
				"triggerOnRestored": {
					"H": "false",
					"T": "prop"
				},
				"DiscardSettings": {
					"H": "true",
					"T": "prop",
					"HL": "QS"
				}
			},
			"E": {
				"getProfiles": {
					"H": "components.loadingCustomComp.open();\r\n\r\n// let requestObject: any = {};\r\n\r\nlet serviceRequest: any = {};\r\n\r\nserviceRequest.blockRender = '';\r\nserviceRequest.data = null;\r\nserviceRequest.url = '/api/blockage-restriction/restrictions/profiles';\r\nserviceRequest.http = 'GET';\r\nserviceRequest.responseField = {};\r\nlet responseField: any = 'getProfilesReponse';\r\nserviceRequest.responseField = responseField;\r\nserviceRequest.onSuccess = 'getProfilesRequestSuccess';\r\nserviceRequest.onFail = 'getProfilesRequestFail';\r\nquick.store.set('$customConsumerCode', quick.store.get('customConsumerCode'));\r\nquick.Request.async(serviceRequest);",
					"C": true,
					"HL": "TS"
				},
				"getProfilesRequestSuccess": {
					"H": "let profileList = response?.getProfilesReponse?.resultList ?? [];\r\n\r\nlet tmpOnlyItem = profileList.filter((item) => item.profileCode == \"VF\")[0];\r\n\r\nlet tmpProfileList = [\r\n    {\r\n        'text': tmpOnlyItem?.desc,\r\n        'value': tmpOnlyItem\r\n    }\r\n];\r\n\r\ncomponents.sel_profile.items = tmpProfileList;\r\ncomponents.sel_profile.qValue = tmpOnlyItem;\r\n\r\ncomponents.col_tcknVknYkn.visible = true;\r\ncomponents.row_customerNumberAndDesc.visible = true;\r\ncomponents.row_btn_apply.visible = true;\r\nquick.MM.trigger('btnApplyDisabled');\r\n\r\ncomponents.loadingCustomComp.close();",
					"C": true,
					"HL": "TS"
				},
				"getProfilesRequestFail": {
					"H": "declare let error;\r\n\r\ncomponents.loadingCustomComp.close();\r\n\r\nlet params = {\r\n    'alertType': 'error',\r\n    'message': ['Beklenmeyen bir hata gerçekleşti.', 'Lütfen daha sonra tekrar deneyiniz.']\r\n};\r\n\r\nif (error.response.data.code && error.response.data.error && error.response.data.message) {\r\n    params = {\r\n        'alertType': 'error',\r\n        'message': [error.response.data.code, error.response.data.error + ' - ' + error.response.data.message]\r\n    }\r\n}\r\n(<any>components.alertCustomComp).open({ 'params': params });",
					"C": true,
					"HL": "TS"
				},
				"createRestriction": {
					"H": "components.loadingCustomComp.open();\r\n\r\nlet customerData: any = quick.containerServices.getCustomerContext() ?? {};\r\n// let customerData = { customerNumber: '161109109' };\r\n\r\ncomponents.loadingCustomComp.open();\r\n\r\nlet profile = components.sel_profile?.qValue ?? {};\r\n// let profile = {\r\n//     \"id\": 3,\r\n//     \"profileCode\": \"VF\",\r\n//     \"desc\": \"Vefat\",\r\n//     \"legislationNo\": {\r\n//         \"id\": 40,\r\n//         \"mainKey\": \"blockage_letter_type\",\r\n//         \"key\": \"\",\r\n//         \"hostValue\": \"\",\r\n//         \"additionalInfo\": \"\",\r\n//         \"description\": \"Boş\"\r\n//     },\r\n//     \"withdrawProhibitedF\": 1,\r\n//     \"depProhibitedF\": 0,\r\n//     \"hasExceptionF\": 0\r\n// }\r\n\r\nlet customer: any = {\r\n    \"customerNumber\": +customerData?.customerNumber,\r\n    \"keyTypeDicId\": 0,\r\n    \"keyTypeVal\": 0\r\n};\r\n\r\nif (customerData.customerType == 'CORPORATE') {\r\n    customer.keyTypeDicId = 29;\r\n    customer.keyTypeVal = +customerData.customerTaxId;\r\n}\r\nelse {\r\n    customer.keyTypeDicId = 30;\r\n    customer.keyTypeVal = +customerData.customerCitizenId;\r\n}\r\n\r\n\r\nlet requestObject: any = {\r\n    \"customers\": [customer],\r\n    \"profileId\": profile?.id,\r\n    \"profileCode\": profile?.profileCode,\r\n    \"description\": components?.txt_input_desc?.qValue?.trim() ?? '',\r\n    \"applyRuleInfo\": {\r\n        \"ruleTypeDicId\": 307,\r\n        \"ruleStDicId\": 309,\r\n        \"ruleHstTrxTypeDicId\": 313\r\n    }\r\n};\r\n\r\nquick.store.set('createRestrictionDescription', requestObject.description);\r\n\r\nlet serviceRequest: any = {};\r\n\r\nserviceRequest.blockRender = '';\r\nserviceRequest.data = requestObject;\r\nserviceRequest.url = '/api/blockage-restriction/restrictions';\r\nserviceRequest.http = 'POST';\r\nserviceRequest.responseField = {};\r\nlet responseField: any = 'createRestrictionReponse';\r\nserviceRequest.responseField = responseField;\r\nserviceRequest.onSuccess = 'createRestrictionRequestSuccess';\r\nserviceRequest.onFail = 'createRestrictionRequestFail';\r\nquick.store.set('$customConsumerCode', quick.store.get('customConsumerCode'));\r\nquick.Request.async(serviceRequest);",
					"C": true,
					"HL": "TS"
				},
				"createRestrictionRequestSuccess": {
					"H": "let customerData: any = quick.containerServices.getCustomerContext() ?? {};\r\nlet customerNameSurname = customerData?.firstName;\r\ncustomerData?.secondName?.trim() != '' ? customerNameSurname += ' ' + customerData?.secondName : customerNameSurname += ' ';\r\ncustomerNameSurname += customerData?.customerSurname?.trim();\r\nlet profile = components.sel_profile?.qValue ?? {};\r\n\r\nlet restrictionData = response?.createRestrictionReponse?.result;\r\n// let restrictionData = {\r\n//     \"restrictionIds\": [\r\n//         5932565\r\n//     ],\r\n//     \"customers\": [{\r\n//         \"customerNumber\": 162006612,\r\n//         \"keyTypeDicId\": 30,\r\n//         \"keyTypeVal\": 21013511048\r\n//     }\r\n//     ],\r\n//     \"profileId\": 3,\r\n//     \"profileCode\": \"VF\",\r\n//     \"applyRestrictionInfo\": {\r\n//         \"description\": \"önyüz testi 9\",\r\n//         \"processDateTime\": \"2026-04-10T15:25:06.9127403+03:00\",\r\n//         \"userInfo\": {\r\n//             \"branchCode\": 4299,\r\n//             \"employeeId\": 200837,\r\n//             \"seqNo\": 1,\r\n//             \"workstationNo\": 154\r\n//         }\r\n//     },\r\n//     \"applyRuleInfo\": {\r\n//         \"ruleTypeDicId\": 307,\r\n//         \"ruleStDicId\": 309,\r\n//         \"ruleHstTrxTypeDicId\": 313\r\n//     }\r\n// }\r\n\r\nif (restrictionData) {\r\n    components.txt_tcknVkn.qValue = restrictionData?.customers[0]?.keyTypeVal ?? '-';\r\n    components.txt_customerNumber.qValue = restrictionData?.customers[0]?.customerNumber ?? '-';\r\n    components.txt_nameSurname.qValue = customerNameSurname ?? '-';\r\n    components.txt_desc.qValue = profile?.desc ?? '-';\r\n    components.txt_status.qValue = 'Aktif';\r\n\r\n    components.txt_applyInfo_branch.qValue = restrictionData?.applyRestrictionInfo?.userInfo?.branchCode ?? '-';\r\n    components.txt_applyInfo_employeeId.qValue = restrictionData?.applyRestrictionInfo?.userInfo?.employeeId ?? '-';\r\n    components.txt_applyInfo_processDate.qValue = restrictionData?.applyRestrictionInfo?.processDateTime ? (new Date(restrictionData?.applyRestrictionInfo?.processDateTime).toLocaleDateString('TR-tr')) : '-';\r\n    components.txt_processDate.qValue = restrictionData?.applyRestrictionInfo?.processDateTime ? (new Date(restrictionData?.applyRestrictionInfo?.processDateTime).toLocaleDateString('TR-tr')) : '-';\r\n    components.txt_applyInfo_processTime.qValue = restrictionData?.applyRestrictionInfo?.processDateTime ? (new Date(restrictionData?.applyRestrictionInfo?.processDateTime).toLocaleTimeString('TR-tr')) : '-';\r\n    components.txt_applyInfo_workstationNo.qValue = restrictionData?.applyRestrictionInfo?.userInfo?.workstationNo ?? '-';\r\n    components.txt_applyInfo_seqNo.qValue = restrictionData?.applyRestrictionInfo?.userInfo?.seqNo ?? '-';\r\n    components.txt_applyInfo_description.qValue = restrictionData?.applyRestrictionInfo?.description ?? '-';\r\n\r\n    let params = {\r\n        'alertType': 'success',\r\n        'message': ['Kısıt koyma işlemi başarıyla sonuçlanmıştır.']\r\n    };\r\n    (<any>components.alertCustomComp).open({ 'params': params });\r\n    components.dia_restrictionDetails.qValue = false;\r\n\r\n    quick.MM.trigger('createAbm',[{'pcuBytesValue':'A'}]);\r\n}\r\nelse {\r\n    let params = {\r\n        'alertType': 'error',\r\n        'message': ['Beklenmeyen bir hata gerçekleşti.', 'Lütfen daha sonra tekrar deneyiniz.']\r\n    };\r\n    (<any>components.alertCustomComp).open({ 'params': params });\r\n\r\n    quick.MM.trigger('createAbm',[{'pcuBytesValue':'A'}]);\r\n}\r\n\r\ncomponents.loadingCustomComp.close();\r\n\r\ncomponents.cont_inputs.visible = false;\r\ncomponents.cont_details.visible = true;\r\n\r\n\r\n\r\n\r\nfunction statusController(dateISOString) {\r\n    let recordDate = new Date(dateISOString).getTime();\r\n    let currentDate = new Date().getTime();\r\n    if (recordDate >= currentDate) {\r\n        return 'Aktif';\r\n    }\r\n    else {\r\n        return 'Pasif';\r\n    }\r\n}",
					"C": true,
					"HL": "TS"
				},
				"createRestrictionRequestFail": {
					"H": "declare let error;\r\n\r\nquick.MM.trigger('createAbm',[{'pcuBytesValue':'A'}]);\r\n\r\ncomponents.loadingCustomComp.close();\r\n\r\nlet params = {\r\n    'alertType': 'error',\r\n    'message': ['Beklenmeyen bir hata gerçekleşti.', 'Lütfen daha sonra tekrar deneyiniz.']\r\n};\r\n\r\nif (error?.response?.data) {\r\n    if (error.response.data?.responseCode == 'BLOCKAGE_RESTRICTION_ALREADY_EXISTS') {\r\n        params = {\r\n            'alertType': 'error',\r\n            'message': ['Müşterinin vefat kısıtı bulunmaktadır.']\r\n        }\r\n    }\r\n    else if (error.response.data?.code && error.response.data?.error && error.response?.data.message) {\r\n        params = {\r\n            'alertType': 'error',\r\n            'message': [error.response.data.code, error.response.data.error + ' - ' + error.response.data.message]\r\n        }\r\n    }\r\n}\r\n\r\n(<any>components.alertCustomComp).open({ 'params': params });",
					"C": true,
					"HL": "TS"
				},
				"btnApplyDisabled": {
					"H": "let tcknVknYkn = components?.txt_input_tcknVknYkn?.qValue ?? '';\r\nlet customerNumber = components?.txt_input_customerNumber?.qValue ?? '';\r\nlet desc = components?.txt_input_desc?.qValue?.trim() ?? '';\r\n\r\nif ((tcknVknYkn != '' || customerNumber != '') && desc != '') {\r\n    components.btn_apply.disabled = false;\r\n    components.tooltip_btn_apply.disabled = true;\r\n}\r\nelse {\r\n    components.btn_apply.disabled = true;\r\n    components.tooltip_btn_apply.disabled = false;\r\n    let toolTipContent = '';\r\n    if (tcknVknYkn == '' && customerNumber == '' && desc == '') {\r\n        toolTipContent = \"- Müşteri Numarası ya da TCKN/VKN/YKN bilgilerinden bir tanesi girilmelidir. - Açıklama girilmelidir.\";\r\n    }\r\n    else if (tcknVknYkn == '' && customerNumber == '') {\r\n        toolTipContent = \"- Müşteri Numarası ya da TCKN/VKN/YKN bilgilerinden bir tanesi girilmelidir.\";\r\n    }\r\n    else {\r\n        toolTipContent = \"- Açıklama girilmelidir.\";\r\n    }\r\n    components.tooltip_btn_apply.toolTipContent = toolTipContent;\r\n}",
					"C": true,
					"HL": "TS"
				},
				"EndRender": {
					"H": "quick.store.set('customConsumerCode', 'TANE.BLKRESTRICTION');",
					"HL": "TS"
				},
				"createAbm": {
					"H": "declare let pcuBytesValue;\r\n\r\nlet customerData: any = quick.containerServices.getCustomerContext() ?? {};\r\n\r\nlet userData: any = quick.containerServices.getUserContext() ?? {};\r\n\r\nlet createRestrictionDescription = quick.store.get('createRestrictionDescription');\r\n\r\nlet restrictionData = response?.createRestrictionReponse?.result;\r\nlet tod = undefined;\r\nlet seqNo = undefined;\r\n\r\nif (restrictionData) {\r\n    tod = restrictionData.tod;\r\n    seqNo = restrictionData.sequenceNo;\r\n}\r\n\r\nlet requestObject: any = {\r\n    \"tod\": tod,\r\n    \"customerNumber\": customerData?.customerNumber ?? \"\",\r\n    \"tellerId\": +userData?.workstationBO?.code,\r\n    \"sequenceNo\": seqNo,\r\n    \"employeeId\": +userData?.userid,\r\n    \"processingOrganizationUnit\": +userData?.workstationBO?.organizationUnitCode,\r\n    \"channelCode\": \"branch\",\r\n    \"transactionCode\": \"KISITISL\",\r\n    \"operationCode\": \"KISITKOY\",\r\n    \"operationAddress\": userData?.ip,\r\n    \"part\": \"0\",\r\n    \"productCode\": 0,\r\n    \"monetaryType\": \"Z\",\r\n    \"accountType\": \"M\",\r\n    \"groupType\": \"Z001\",\r\n    \"type\": \"A\",\r\n    \"pcuBytes\": pcuBytesValue,\r\n    \"isCancellation\": false,\r\n    \"abmDetails\": {\r\n        \"operationDescription\": createRestrictionDescription,\r\n    }\r\n};\r\n\r\n\r\nif (customerData.customerType == 'CORPORATE') {\r\n    requestObject.taxId = +customerData.customerTaxId;\r\n}\r\nelse {\r\n    requestObject.citizenId = +customerData.customerCitizenId;\r\n}\r\n\r\n\r\nlet serviceRequest: any = {};\r\n\r\nserviceRequest.blockRender = '';\r\nserviceRequest.data = requestObject;\r\nserviceRequest.url = '/api/blockage-restriction/create-abm';\r\nserviceRequest.http = 'POST';\r\nserviceRequest.responseField = {};\r\nlet responseField: any = 'createAbmReponse';\r\nserviceRequest.responseField = responseField;\r\nserviceRequest.onSuccess = 'createAbmRequestSuccess';   // kullanılmıyor/bakılmıyor, o yüzden oluşturulmadı\r\nserviceRequest.onFail = 'createAbmRequestFail';         // kullanılmıyor/bakılmıyor, o yüzden oluşturulmadı\r\nquick.store.set('$customConsumerCode', quick.store.get('customConsumerCode'));\r\nquick.Request.async(serviceRequest);",
					"C": true,
					"HL": "TS"
				}
			},
